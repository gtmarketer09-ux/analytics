# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gt_analytics
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/gt_analytics"

# Google Cloud & BigQuery
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google OAuth & AdMob
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
ADMOB_REFRESH_TOKEN=your_admob_refresh_token
ADMOB_PUBLISHER_ID=pub-1234567890123456
ADMOB_AUD_TO_USD_RATE=0.65
ADMOB_REDIRECT_URI=https://developers.google.com/oauthplayground
REDIRECT_URL=https://developers.google.com/oauthplayground

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Google Play Console
PLAY_CONSOLE_BUCKET=pubsite_prod_your_bucket_id
PLAY_CONSOLE_SERVICE_ACCOUNT=./console_service_account.json

# Internal Cron Security
CRON_SECRET=your_random_secret_string

# Dashboard Sign-in Authentication
DASHBOARD_USER=CEO
DASHBOARD_PASSWORD="your_dashboard_password"
SESSION_SECRET=your_long_random_session_secret_key

# Ngrok Public Tunnel (Optional)
NGROK_AUTH_TOKEN=your_ngrok_auth_token
